{% case media.media_type %}
    {% when 'image' %}
        <img src="{{ media | image_url: width: 450 }}" alt="{{ media.preview_image.alt | escape }}" class="w-full h-full object-cover" width="400" height="auto" loading="lazy">
    {% when 'external_video' %}
        {{ media | external_video_tag: class: 'w-full h-80 object-cover' }}
    {% when 'video' %}
        {{ media | video_tag: controls: true, class: 'w-full h-full object-cover' }}
    {% when 'model' %} 
        {{ media | model_viewer_tag: class: 'w-full h-full object-cover' }}
    {% else %}
        {{ media | media_tag: class: 'w-full h-full object-cover' }}
{% endcase %}